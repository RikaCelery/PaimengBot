<html lang="zh">
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Noto+Sans+JP:wght@100..900&family=Noto+Sans+KR:wght@100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Sans+TC:wght@100..900&family=Questrial&display=swap" rel="stylesheet">
<head>
  <style>

.template {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0.3;
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  /* font-family: "Noto Serif", "Fira Sans", "helvetica neue","Noto Color Emoji", sans-serif; */
}

html {
    font-family: "Noto Sans SC","Noto Sans TC","Noto Sans JP","Noto Sans KR", "Noto Sans Math", "Noto Color Emoji",sans-serif;
  }
body {
  padding: 20px;
  padding-bottom: 10px;
  background: linear-gradient(45deg, #ffefef, #ddefff);
  color: rgb(44, 44, 44);
}

main {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.254);
  border-radius: 10px;
  overflow: hidden;
  padding: 1em;
  box-shadow: 0px 0px 20px #00000021;
}

.header {
  height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0em;
  /* margin-bottom: .5em; */
}

.author-logo,
.platform-logo {
  /* width: 50px; */
  height: 100%;
  overflow: hidden;
}

.author-logo {
  padding: 15px;
}

.platform-logo {
  padding: 15px 0;
  aspect-ratio: 1;
  align-self: self-start;
}

.author-logo img {
  border-radius: 999px !important;
}

.author-name {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-name .nick {
  font-size: calc(1vw + 14px);
  font-weight: 600;
}

.author-name .id {
  color: gray;
  font-size: calc(1vw + 10px);
  font-weight: 300;
}

.content {
  padding: 10px;
  font-size: calc(1vw + 15px);
}

.content img,
.content video {
  display: block;
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  height: auto;
  /*max-height: 600px;*/
  border-radius: 20px;
  margin-top: 5px;
  margin-bottom: 5px;
}

.header img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.rsshub-quote {
  background-color: rgba(255, 255, 255, 0.454);
  border: 1px solid #2e2e2e1f;
  border-radius: 20px;
  padding: 10px;
  margin-top: 10px;
}

.tag {
  color: rgb(0, 170, 255);
}

footer {
  font-size: small;
  padding-top: 7px;
  text-align: center;
  font-weight: 300;
  color: rgb(162, 162, 162);
}
  </style>
</head>
<body>
  <main>
    <div class="header">
      <div class="author-logo"><img src="{{.Image.URL}}" /></div>
      <div class="author-name">
        <div class="nick">{{(index .Items 0).Author.Name}}</div>
        <div class="id">
          @{{.Link | replace ".*\\.com/(\\w+)/status/.*" "$1" }}
        </div>
      </div>
      <div class="platform-logo">
        <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100" height="100" viewBox="0 0 50 50"
          style="height: 100%; fill: rgba(128, 128, 128, 0.255)">
          <path
            d="M 50.0625 10.4375 C 48.214844 11.257813 46.234375 11.808594 44.152344 12.058594 C 46.277344 10.785156 47.910156 8.769531 48.675781 6.371094 C 46.691406 7.546875 44.484375 8.402344 42.144531 8.863281 C 40.269531 6.863281 37.597656 5.617188 34.640625 5.617188 C 28.960938 5.617188 24.355469 10.21875 24.355469 15.898438 C 24.355469 16.703125 24.449219 17.488281 24.625 18.242188 C 16.078125 17.8125 8.503906 13.71875 3.429688 7.496094 C 2.542969 9.019531 2.039063 10.785156 2.039063 12.667969 C 2.039063 16.234375 3.851563 19.382813 6.613281 21.230469 C 4.925781 21.175781 3.339844 20.710938 1.953125 19.941406 C 1.953125 19.984375 1.953125 20.027344 1.953125 20.070313 C 1.953125 25.054688 5.5 29.207031 10.199219 30.15625 C 9.339844 30.390625 8.429688 30.515625 7.492188 30.515625 C 6.828125 30.515625 6.183594 30.453125 5.554688 30.328125 C 6.867188 34.410156 10.664063 37.390625 15.160156 37.472656 C 11.644531 40.230469 7.210938 41.871094 2.390625 41.871094 C 1.558594 41.871094 0.742188 41.824219 -0.0585938 41.726563 C 4.488281 44.648438 9.894531 46.347656 15.703125 46.347656 C 34.617188 46.347656 44.960938 30.679688 44.960938 17.09375 C 44.960938 16.648438 44.949219 16.199219 44.933594 15.761719 C 46.941406 14.3125 48.683594 12.5 50.0625 10.4375 Z">
          </path>
        </svg>
      </div>
    </div>
    <div class="content">{{(index .Items 0).Description|escape }}
    </div>
    <div class="info"></div>
  </main>
  <footer>Generated by Mikaku · Inspired by Mephisto (nullqwertyuiop) R.I.P🕯️</footer>
</body>
<style>
</style>
<script>
  document.querySelector("main").innerHTML = document.querySelector("main").innerHTML.replace(/#[^< ]+/g, function (str) {
    console.log(str);
    return `<span class="tag">${str}</span>`
  })
</script>

</html>