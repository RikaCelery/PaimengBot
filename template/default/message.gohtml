<html>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" rel="stylesheet">
<style id="font-tokens">
    :root {
        --font-bold: 500;
        --font_size_1: 8px;
        --font_size_2: 10px;
        --font_size_3: 12px;
        --font_size_4: 14px;
        --font_size_5: 16px;
        --avatar_size_1: 20px;
        --avatar_size_2: 32px;
        --avatar_size_3: 40px;
        --font_size_main_1: 10px;
        --font_size_main_2: 12px;
        --line_height_1: 12px;
        --line_height_2: 14px;
        --line_height_3: 16px;
        --line_height_4: 20px;
        --line_height_5: 22px;
        --line_height_main_1: 16px;
        --line_height_main_2: 18px;
    }
</style>
<style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Noto+Color+Emoji&family=Noto+Sans+Math&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+JP:wght@200..900&family=Noto+Serif+KR:wght@200..900&family=Noto+Serif+SC:wght@200..900&family=Yuji+Mai&display=swap');
    * {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }
    html {
        font-family: "Noto Sans SC", "Noto Sans JP", "Noto Sans KR", "Noto Sans Math", "Noto Color Emoji", sans-serif;
    }

    body {
        background: linear-gradient(to left bottom, #e66465, #e5c391);
        width: fit-content;
        height: fit-content;
        padding: 0;
        margin: 0;
    }

    :root {
        --bqqnt-base-text-color: 0, 0, 0;
    }

    .avatar-span {
        height: 32px;
        width: 32px;
        position: absolute;
        bottom: 8px;
        left: 10px;
        border-radius: 50%;
        overflow: hidden;
    }

    .avatar {
        background-position: center;
        background-size: cover;
        width: 32px;
        height: 32px;
        background-repeat: no-repeat;
    }

    .messages-container {
        position: relative;
        display: grid;
        grid-auto-rows: min-content;
        grid-template-areas: "checkbox avatar . nickname nickname nickname" "checkbox avatar . content status ." "checkbox avatar . tips . .";
        grid-template-columns:
          auto var(--avatar_size_2) 8px auto calc(var(--avatar_size_2) + 8px)
          1fr;
        justify-content: start;
        transition-duration: 0.3s;
        padding: 4px 10px;
    }

    .messages-container .user-name {
        align-items: center;
        /*color: var(--on_bg_text);*/
        display: flex;
        grid-row-start: nickname;
        grid-column-start: nickname;
        grid-row-end: nickname;
        grid-column-end: nickname;
        min-height: 18px;
        position: relative;
        user-select: none;
        font-size: var(--font_size_2);
        line-height: var(--line_height_2);
        color: color(srgb 0 0.116139 0.153846 / 0.52);

        width: min-content;
        /*color: color-mix(*/
        /*        in srgb,*/
        /*        var(--md-sys-color-primary-container),*/
        /*        rgba(var(--bqqnt-base-text-color), 0.4) 80%*/
        /*);*/
        padding: 0 0 3px 1px;
    }

    .msg-content-container * {
        max-width: 100%;
    }

    .messages-content__wrapper {
        background-color: rgba(255, 255, 255, 0.3);
        box-shadow: rgba(16, 35, 47, 0.149) 2px 2px 6px 0;
        border-radius: 3px 15px 15px 3px;
        padding: 5px 15px 8px 5px;
        width: 100%;
        min-width: 100px;
        grid-area: content;
    }

    .text-ellipsis {
        max-width: 100%;
        overflow-x: hidden;
        overflow-y: hidden;
        text-overflow: ellipsis;
        white-space-collapse: collapse;
        text-wrap: nowrap;
        unicode-bidi: isolate;
    }

    .user-name .q-tag {
        background: transparent;
    }

    .messages-container .user-name .group-member-label {
        margin-left: 4px;
        font-size: min(var(--font_size_1), 14px);
        line-height: min(var(--line_height_1), 20px);
    }

    .quote .user-name,
    .quote .user-name .group-member-label,
    .quote .text-normal {
        color: #ffffffce;
        font-size: var(--font_size_2);
    }

    .msg-content-container {
        display: flex;
        flex-direction: column;
    }

    .messages-content__wrapper {
        font-size: var(--font_size_main_2);
        line-height: max(var(--line_height_main_2), 22px);
        overflow-x: hidden;
        overflow-y: hidden;
        position: relative;
        max-width: 400px;
    }

    .quote__wrapper {
        padding: 5px 5px 5px 10px;
        position: relative;
        box-shadow: inset 2px 0 0 0px rgba(0, 0, 0, 0.221);
        background-color: rgba(0, 0, 0, 0.03);
    }

    .quote {
        border-radius: 3px 10px 10px 3px;
        overflow: hidden;
        width: fit-content;
    }

    .pic-element {
        border-radius: 4px;
        width: fit-content;
        height: fit-content;
        overflow-x: hidden;
        overflow-y: hidden;
        margin: 4px 0px;
    }

    .image-content {
        height: 100%;
        image-rendering: high-quality;
        object-fit: cover;
        object-position: center top;
        text-indent: 100%;
        width: auto;
        max-height: 300px;
        min-height: 30px;
    }

    .wrapper {
        width: fit-content;
        height: fit-content;
    }
</style>
<body style="">
