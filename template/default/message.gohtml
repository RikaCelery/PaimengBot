<script>
    document.querySelector(".wrapper").clientWidth;
    window.innerWidth;

    function xmlescape(str) {
        if (!str || str.trim().length == 0) return "";
        return str
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&apos;")
            .replace(/\n/g, "<br>")
            .replace(/\r/g, "")
            .replace(/\t/g, "&nbsp;&nbsp;&nbsp;&nbsp;")
            .replace(/ /g, "&nbsp;");
    }

    function cleanUnicodeControlsAndEscape(str) {
        if (!str || str.trim().length == 0) return "";
        return str
            .replace(
                /[\u0000-\u001F\u007F-\u009F\u200E\u200F\u202A-\u202E\uFEFF]/g,
                ""
            )
            .replace(/\n/g, "") //clean \n
            .replace(/\r/g, "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\t/g, "&nbsp;&nbsp;&nbsp;&nbsp;")
            .replace(/ /g, "&nbsp;");
    }

    function createMsgEL(msg, hideInfo) {
        let quoteEL = "";
        if (msg.quote)
            quoteEL = `
                      <div class="quote">
                        <div class="quote__wrapper">
                          <div class="user-name no-copy text-ellipsis">
                            <span class="text-ellipsis">${cleanUnicodeControlsAndEscape(
                msg.quote.name
            )}</span>
                          </div>
                      ${msg.quote.messages.map((m) => {
                switch (m.type) {
                    case "text":
                        return `<span class="text-normal">${xmlescape(
                            m.data
                        )}</span>`;
                        break;
                    case "image":
                        return `
                      <div class="image pic-element">
                        <img
                          class="image-content"
                          src="${m.data}"
                        />
                      </div>`;
                    default:
                        return `<span class="text-normal">${xmlescape(
                            JSON.stringify(m)
                        )}</span>`
                }
            }).join("")}
                        </div>
                      </div>
                      `;
        const msgEL = document.createElement("div");
        msgEL.className = "messages";
        msgEL.innerHTML = `
                <div class="messages-container">
                  <span class="avatar-span"
                    style="${hideInfo ? "display:none;" : ""}"
                    ><div
                      class="avatar messages-container__avatar"
                      style="
                        background-image: url('http://q4.qlogo.cn/g?b=qq&nk=${
            msg.qid
        }&s=640');
                      "
                    ></div
                  ></span>
                  <div class="messages-content__wrapper">
                    <div
                      class="msg-content-container container--others mix-messages__container"
                      style="--img-max-width: 324px;"
                    >
                      <div class="user-name no-copy text-ellipsis"
                      style="${hideInfo ? "" : ""}">
                        <span class="text-ellipsis">${xmlescape(
            msg.name
        )}</span>
                        <div class="q-tag q-tag--blue group-member-label">
                          <span class="title">${xmlescape(msg.label)}</span>
                        </div>
                      </div>
                      ${quoteEL}
                      ${msg.messages
            .map((m) => {
                console.log(m);
                switch (m.type) {
                    case "text":
                        return `<span class="text-normal">${xmlescape(
                            m.data
                        )}</span>`;
                        break;
                    case "image":
                        return `
                      <div class="image pic-element">
                        <img
                          class="image-content"
                          src="${m.data}"
                        />
                      </div>`;
                    default:
                        return `<span class="text-normal">${xmlescape(
                            JSON.stringify(m)
                        )}</span>`
                }
            })
            .join("")}
                    </div>
                  </div>
                </div>
      `;
        return msgEL;
    }

    var mllist = document.querySelector(".wrapper");
    var username = "Gertrud Kiwifruit";
    var msgs = JSON.parse({{.}});
    var msgs1 = [
        {
            name: "我是马卡龙，枪马网卡耳朵龙",
            label: "admin",
            time: 1724212701,
            qid: 1003576370,
            quote: null,
            messages: [{type: "text", data: "？"}],
        },
        {
            name: "[似了]rika?? ?? ???",
            time: 1724212701,
            qid: 2590369447,
            quote: null,
            messages: [
                {
                    type: "image",
                    data: "http://gchat.qpic.cn/gchatpic_new/2590369447/607726866-4169007363-B9A8DD50EF292E417BA884C7E406E847/0?term=255&is_origin=1",
                },
                {
                    type: "image",
                    data: "https://multimedia.nt.qq.com.cn/download?appid=1407&fileid=CgoyNTkwMzY5NDQ3EhQvvExJO5rg0hE6j1s2eBSpBmSLnBizugEg_woovfOF8ZeFiANQgL2jAQ&rkey=CAQSKAB6JWENi5LMmc0_msJPdnQI_NH32qkjsOC4idS5g530gcFe1yaWhI4",
                },
            ],
        },
        {
            name: "??",
            label: "admin",
            time: 1724212701,
            qid: 1436898372,
            quote: null,
            messages: [{type: "text", data: "UI写的还挺好看"}],
        },
    ];
    msgs.forEach((msg, idx) => {
        const msgEL = createMsgEL(msg, (msgs[idx + 1] || {}).qid == msg.qid);
        mllist.appendChild(msgEL);
    });
    Promise.all(
        Array.from(document.images)
            .filter((img) => !img.complete)
            .map(
                (img) =>
                    new Promise((resolve) => {
                        img.onload = img.onerror = resolve;
                    })
            )
    ).then(() => {
        setInterval(() => {
            console.log("images finished loading");
            console.log("done");
        }, 500);
    });
</script>
</html>